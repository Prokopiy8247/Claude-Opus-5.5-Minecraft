# Unreal generated folders
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/
Builds/
Plugins/*/Binaries/
Plugins/*/Intermediate/

# IDE / solution files (regenerated by UnrealBuildTool)
.vs/
.vscode/
.idea/
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.xcworkspace
*.pdb

# Blender backups
*.blend1
*.blend2

# Temp / tool outputs
Tools/**/__pycache__/
Tools/BlenderMCP/*.png
*.tmp
.opus55-run/

# Platform / editor user files
.DS_Store
*.xcuserstate
*.xcuserdata/
Config/DefaultEditorPerProjectUserSettings.ini

# Local secrets and signing material (examples may be committed explicitly)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials.json
secrets.json

# Packaged Shipping game placed in the project folder by .opus55-run/package_game.bat (rebuildable, ~0.5 GB)
/Unreal_Minecraft.exe
/Unreal_Minecraft/
/Engine/
/Manifest_*.txt
/NOTICES.txt
/.opus55-run/package/
