[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
rendering_device/driver.windows="d3d12"
lights_and_shadows/directional_shadow/size=2048
environment/defaults/default_clear_color=Color(0.47, 0.65, 1, 1)

[shader_globals]

daylight={
"type": "float",
"value": 1.0
}
sky_tint={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
ambient_light={
"type": "float",
"value": 0.0
}
gamma_boost={
"type": "float",
"value": 0.5
}
night_vision={
"type": "float",
"value": 0.0
}
block_flicker={
"type": "float",
"value": 1.0
}
world_time={
"type": "float",
"value": 0.0
}
