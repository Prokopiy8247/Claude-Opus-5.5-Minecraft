; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Godot Minecraft"
config/description="Single-player block sandbox recreation built in Godot 4 with GDScript."
config/version="1.0.0"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.1, 0.09, 0.08, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Game="*res://game/core/game.gd"
Sfx="*res://game/audio/sfx.gd"

[debug]

gdscript/warnings/unused_variable=0
gdscript/warnings/unused_local_constant=0
gdscript/warnings/unused_private_class_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/shadowed_global_identifier=0
gdscript/warnings/incompatible_ternary=0
gdscript/warnings/static_called_on_instance=0
gdscript/warnings/redundant_await=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/confusable_local_declaration=0
gdscript/warnings/confusable_local_usage=0
gdscript/warnings/inference_on_variant=0

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/opus55_tools/plugin.cfg")

